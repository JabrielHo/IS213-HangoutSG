{
  "openapi": "3.0.0",
  "info": {
    "title": "Event Management API",
    "version": "1.0.0",
    "description": "API for managing events"
  },
  "servers": [
    {
      "url": "http://localhost:5004",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/events": {
      "post": {
        "summary": "Create a new event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "community_id": { "type": "integer" },
                  "organizer_id": { "type": "integer" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "location": { "type": "string" },
                  "event_date": { "type": "string", "format": "date-time" },
                  "capacity": { "type": "integer" }
                },
                "required": ["community_id", "organizer_id", "title", "event_date"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Event created successfully" },
          "500": { "description": "Internal server error" }
        }
      },
      "get": {
        "summary": "Get all upcoming events",
        "responses": {
          "200": { "description": "List of upcoming events" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/events/{event_id}": {
      "get": {
        "summary": "Get event by ID",
        "parameters": [
          { "name": "event_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Event details" },
          "404": { "description": "Event not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "delete": {
        "summary": "Soft delete an event",
        "parameters": [
          { "name": "event_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Event soft deleted" },
          "404": { "description": "Event not found" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/events/organizer/{organizer_id}": {
      "get": {
        "summary": "Get all events by organizer ID",
        "parameters": [
          { "name": "organizer_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of events organized by user" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/events/community/{community_id}": {
      "get": {
        "summary": "Get all upcoming events by community ID",
        "parameters": [
          { "name": "community_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of upcoming events in the community" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  }
}
