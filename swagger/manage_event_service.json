{
  "openapi": "3.0.0",
  "info": {
    "title": "Composite Events API",
    "description": "API for managing composite event operations, including creation, deletion, and notifications.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5009",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/events": {
      "post": {
        "summary": "Create a new event",
        "description": "Creates a new event and notifies community members.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing or invalid parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/events/{event_id}": {
      "delete": {
        "summary": "Delete an event",
        "description": "Deletes an event and notifies registered users.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted successfully"
          },
          "404": {
            "description": "Event not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "community_id": { "type": "string" },
          "organizer_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "event_date": { "type": "string", "format": "date-time" },
          "capacity": { "type": "integer" }
        },
        "required": ["community_id", "organizer_id", "title", "event_date", "location", "description", "capacity"]
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "event_id": { "type": "string" }
        }
      }
    }
  }
}
