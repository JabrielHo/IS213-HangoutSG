{
    "openapi": "3.0.0",
    "info": {
      "title": "Post Service API",
      "description": "API for managing posts in a social network",
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "{server}",
        "variables": {
          "server": {
            "default": "http://localhost:5002"
          }
        }
      }
    ],
    "tags": [
      {
        "name": "Posts",
        "description": "Operations related to posts"
      }
    ],
    "paths": {
      "/api/post": {
        "post": {
          "tags": ["Posts"],
          "summary": "Create a new post",
          "description": "Creates a new post with the provided information",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostInput"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Post created successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Missing required fields",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/posts": {
        "get": {
          "tags": ["Posts"],
          "summary": "Get all posts",
          "description": "Retrieves a list of all posts",
          "responses": {
            "200": {
              "description": "List of posts",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostListResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/posts/community/{community_id}": {
        "get": {
          "tags": ["Posts"],
          "summary": "Get posts by community",
          "description": "Retrieves all posts for a specific community",
          "parameters": [
            {
              "name": "community_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID of the community"
            }
          ],
          "responses": {
            "200": {
              "description": "List of posts in the community",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostListResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/posts/author/{author_id}": {
        "get": {
          "tags": ["Posts"],
          "summary": "Get posts by author",
          "description": "Retrieves all posts by a specific author",
          "parameters": [
            {
              "name": "author_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID of the author"
            }
          ],
          "responses": {
            "200": {
              "description": "List of posts by the author",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostListResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/post/{post_id}": {
        "get": {
          "tags": ["Posts"],
          "summary": "Get a specific post",
          "description": "Retrieves a post by its ID",
          "parameters": [
            {
              "name": "post_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID of the post"
            }
          ],
          "responses": {
            "200": {
              "description": "Post details",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostDetailResponse"
                  }
                }
              }
            },
            "404": {
              "description": "Post not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/post/{post_id}/status": {
        "put": {
          "tags": ["Posts"],
          "summary": "Update post status",
          "description": "Updates the status of a post (published/unpublished)",
          "parameters": [
            {
              "name": "post_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "ID of the post"
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusUpdate"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Post status updated",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PostDetailResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid status",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "404": {
              "description": "Post not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "PostInput": {
          "type": "object",
          "required": ["community_id", "author_id", "title", "content"],
          "properties": {
            "community_id": {
              "type": "string",
              "description": "ID of the community the post belongs to"
            },
            "author_id": {
              "type": "string",
              "description": "ID of the post author"
            },
            "title": {
              "type": "string",
              "description": "Title of the post"
            },
            "content": {
              "type": "string",
              "description": "Content of the post"
            }
          }
        },
        "Post": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier for the post"
            },
            "community_id": {
              "type": "string",
              "description": "ID of the community the post belongs to"
            },
            "author_id": {
              "type": "string",
              "description": "ID of the post author"
            },
            "title": {
              "type": "string",
              "description": "Title of the post"
            },
            "content": {
              "type": "string",
              "description": "Content of the post"
            },
            "status": {
              "type": "string",
              "enum": ["published", "unpublished"],
              "description": "Status of the post"
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the post was created"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the post was last updated"
            }
          }
        },
        "StatusUpdate": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["published", "unpublished"],
              "description": "New status value"
            }
          }
        },
        "PostResponse": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "example": 201
            },
            "message": {
              "type": "string",
              "example": "Post created"
            },
            "data": {
              "$ref": "#/components/schemas/Post"
            }
          }
        },
        "PostDetailResponse": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "example": 200
            },
            "data": {
              "$ref": "#/components/schemas/Post"
            }
          }
        },
        "PostListResponse": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "example": 200
            },
            "data": {
              "type": "object",
              "properties": {
                "posts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Post"
                  }
                }
              }
            }
          }
        },
        "ErrorResponse": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "description": "HTTP status code"
            },
            "message": {
              "type": "string",
              "description": "Error message"
            }
          }
        }
      }
    }
  }